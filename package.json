{
  "name": "opencode-prompt-tracker",
  "version": "1.0.0",
  "description": "OpenCode plugin to log prompts, models, agents, duration, and token usage to daily Markdown files",
  "main": "dist/release/opencode-prompt-tracker.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --outfile=dist/release/opencode-prompt-tracker.js",
    "test": "bun test",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "logging",
    "tokens",
    "prompts",
    "agent"
  ],
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudStrolling/opencode-prompt-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/CloudStrolling/opencode-prompt-tracker/issues"
  },
  "homepage": "https://github.com/CloudStrolling/opencode-prompt-tracker#readme",
  "files": [
    "dist/release/",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0"
  }
}
